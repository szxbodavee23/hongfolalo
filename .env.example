POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_USER=honfoglalo
POSTGRES_PASSWORD=honfoglalo_pass
POSTGRES_DB=honfoglalo
PORT=3000
AUTH_SECRET=change_this_to_a_long_random_secret_string

# Google reCAPTCHA v2 keys (site key is public, secret key stays server-side only!)
RECAPTCHA_SITE_KEY=
RECAPTCHA_SECRET_KEY=

# Email Verification Provider (Resend API, Brevo API, or SMTP)
# Resend: get an API key at resend.com. IMPORTANT: the default onboarding@resend.dev
# sender only delivers to your own Resend account email. To mail real users you MUST
# verify honfoglalo.site at resend.com/domains (add its DNS records in Namecheap),
# then set EMAIL_FROM to an address on that domain.
RESEND_API_KEY=
BREVO_API_KEY=
EMAIL_FROM=Honfoglaló <noreply@honfoglalo.site>
SMTP_HOST=
SMTP_PORT=465
SMTP_USER=
SMTP_PASS=
